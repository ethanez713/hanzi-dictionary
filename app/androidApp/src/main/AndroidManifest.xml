<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Persistent read access to the photo library for scanning recent photos.
         READ_MEDIA_IMAGES is the API 33+ scoped-media permission; older devices fall
         back to READ_EXTERNAL_STORAGE (capped so it isn't requested on 33+). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Package-visibility exemption for the device's TTS engine: without this, apps
         targeting API 30+ can't bind any TTS service (AppsFilter blocks it silently and
         MandarinTts never becomes available). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".HanziApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HanziDictionary">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share target (spec §9 capture, M3.7): send text from any app; hanzi in
                 it opens directly (one char) or prefills search. singleTask keeps a
                 share-while-open from stacking a second activity. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen flashcard (spec §17). Not exported to other apps: the only thing
             that sends it the GRADE action is the widget's own PendingIntents, which the
             launcher fires on our behalf. -->
        <receiver
            android:name=".widget.PracticeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.hanzidictionary.app.widget.GRADE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/practice_widget_info" />
        </receiver>
    </application>

</manifest>
