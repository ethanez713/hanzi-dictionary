<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen flashcard (spec §17). Launchers give widgets taps but never gestures, so
     the app's swipe grammar becomes tap targets: one full-height gutter per verb, ✗ on the
     left and ✓ on the right — exactly the two verbs the practice screen grades with.
     (Hard/Easy used to split each gutter into stacked halves; they're gone app-wide — a
     half-height strip on a 3-cell widget is a mis-tap waiting to happen, and having the
     same two verbs in both places is worth more than the extra scale.) The card in the
     middle flips to reveal the answer and, once revealed, opens the app on this exact card.
     No list name is drawn: on a widget that real estate is worth more as card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal">

    <!-- LEFT gutter: you didn't know it. -->
    <LinearLayout
        android:id="@+id/zone_miss"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_zone_miss"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Didn't know it"
            android:text="✗"
            android:textColor="@color/widget_icon_miss"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="again"
            android:textColor="@color/widget_icon_miss"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="38sp" />

        <!-- The reveal line: "Tap to reveal" while the card is face-down, this card's own
             pinyin + definition once it's been flipped. -->
        <TextView
            android:id="@+id/widget_echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <!-- Gone until a refresh has a streak or a review today; an empty day with no
             run says nothing rather than "0-day streak". -->
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- RIGHT gutter: you recalled it. -->
    <LinearLayout
        android:id="@+id/zone_knew"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_zone_knew"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Knew it"
            android:text="✓"
            android:textColor="@color/widget_icon_knew"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="knew"
            android:textColor="@color/widget_icon_knew"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
