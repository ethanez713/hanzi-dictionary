<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded study notification: the practice screen in miniature. Amber ✗ AGAIN gutter on
     the left, jade ✓ KNEW gutter on the right, the face-down card between them on paper0 with
     its glyph in Noto CJK and "Tap to reveal" beneath, exactly as the practice card's front
     reads. Tapping the card opens it in the app (revealed); the gutters grade in place.

     Every piece of text is an ImageView holding a bitmap drawn in the app's own typefaces
     (NudgeArt): RemoteViews TextViews can't use the bundled fonts, and a system-font glyph
     next to the app's Noto one is exactly the mismatch this layout exists to avoid. The
     bitmaps are alpha masks tinted from @color/nudge_*, the Ethan tokens.

     Notifications can't flip a card in place without re-posting, so the *previous* card's
     answer rides in the line above the row — a miss still teaches you the word.
     RemoteViews inflates a whitelist of view classes only: ImageView/LinearLayout here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="8dp">

    <!-- The rotating headline, in Piazzolla like every screen title. -->
    <ImageView
        android:id="@+id/nudge_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitStart" />

    <!-- The card just graded: glyph (Noto), its answer (Instrument Sans, muted), and the
         verdict in the gutter colour it was graded with. -->
    <LinearLayout
        android:id="@+id/nudge_previous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nudge_previous_front"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <!-- wrap_content, not a weight: a stretched ImageView with adjustViewBounds would scale
             the text *up*; the bitmap is already ellipsized to its share of the row. -->
        <ImageView
            android:id="@+id/nudge_previous_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <ImageView
            android:id="@+id/nudge_previous_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- LEFT gutter: you didn't know it. -->
        <LinearLayout
            android:id="@+id/zone_miss"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notif_zone_miss"
            android:contentDescription="Didn't know it"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/zone_miss_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/zone_miss_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zone_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="3"
            android:background="@drawable/notif_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- centerInside: shrink if the shade is narrower than estimated, never enlarge
                 past the size the glyph was drawn at. -->
            <ImageView
                android:id="@+id/nudge_glyph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/nudge_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- RIGHT gutter: you recalled it. -->
        <LinearLayout
            android:id="@+id/zone_knew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notif_zone_knew"
            android:contentDescription="Knew it"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/zone_knew_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/zone_knew_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
