<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded study-reminder card: the home-screen widget, larger (see widget_practice.xml for
     why the verbs are two full-height gutters). ✗ on the left, ✓ on the right, the card in
     the middle; tapping the card opens it in the app. Notifications can't flip a card in
     place without re-posting, so the *previous* card's answer rides in the line above — a
     miss still teaches you the word. The glyph auto-sizes to fill the middle zone, which is
     the whole point of this layout over the collapsed one.
     RemoteViews inflates a whitelist of view classes only: TextView/LinearLayout here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/nudge_previous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:orientation="horizontal">

        <!-- LEFT gutter: you didn't know it. -->
        <LinearLayout
            android:id="@+id/zone_miss"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notif_zone_miss"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Didn't know it"
                android:text="✗"
                android:textColor="@color/widget_icon_miss"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="again"
                android:textColor="@color/widget_icon_miss"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zone_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/nudge_glyph"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="96sp"
                android:autoSizeMinTextSize="32sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text" />

            <TextView
                android:id="@+id/nudge_echo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Tap to open"
                android:textColor="@color/widget_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- RIGHT gutter: you recalled it. -->
        <LinearLayout
            android:id="@+id/zone_knew"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/notif_zone_knew"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Knew it"
                android:text="✓"
                android:textColor="@color/widget_icon_knew"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="knew"
                android:textColor="@color/widget_icon_knew"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
