<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed study notification: the same three zones as notification_card.xml in a one-row
     strip, so ✗ and ✓ are reachable without expanding it. Marks only (the practice gutters'
     "hints off" look) and the glyph alone — no room for labels at this height. IDs match the
     expanded layout so one bind routine fills both. 48dp: under DecoratedCustomViewStyle the
     system header takes part of the collapsed height, so a taller strip risks clipping. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/zone_miss"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/notif_zone_miss"
        android:contentDescription="Didn't know it"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/zone_miss_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="3"
        android:background="@drawable/notif_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <ImageView
            android:id="@+id/nudge_glyph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_knew"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/notif_zone_knew"
        android:contentDescription="Knew it"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/zone_knew_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
