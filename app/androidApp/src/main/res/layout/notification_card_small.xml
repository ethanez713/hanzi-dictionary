<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed study-reminder card: the same three zones in a one-row-high strip, so the ✗/✓
     are reachable without expanding the notification. IDs match notification_card.xml so one
     bind routine fills both. 48dp: under DecoratedCustomViewStyle the system header takes part
     of the collapsed height, so a taller strip risks clipping. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/zone_miss"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/notif_zone_miss"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Didn't know it"
            android:text="✗"
            android:textColor="@color/widget_icon_miss"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/nudge_glyph"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text" />

        <TextView
            android:id="@+id/nudge_echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/zone_knew"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/notif_zone_knew"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Knew it"
            android:text="✓"
            android:textColor="@color/widget_icon_knew"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
