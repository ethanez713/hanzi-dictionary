<?xml version="1.0" encoding="utf-8"?>
<!-- The flashcard face in the study notification: the practice card's paper0 surface. In the
     app the card reads against the paper1 screen; the notification shade is plain white or
     grey, so a hairline border does that job here. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/nudge_paper" />
    <stroke android:width="1dp" android:color="@color/nudge_border" />
    <corners android:radius="12dp" />
</shape>
