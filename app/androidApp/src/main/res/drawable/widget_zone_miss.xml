<?xml version="1.0" encoding="utf-8"?>
<!-- Left tap zone. Rounded only on the left so the two zones read as gutters of the card
     rather than as separate buttons floating on the wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_zone_miss" />
    <corners
        android:bottomLeftRadius="20dp"
        android:topLeftRadius="20dp" />
</shape>
