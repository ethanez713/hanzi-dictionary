<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies the real theming (Material 3 dynamic color in AppTheme); this
         is just the launch/base theme the manifest points at. The overrides below match
         it to Compose's background so the window drawn before Compose starts doesn't
         flash a different color, and leave both bars transparent for enableEdgeToEdge. -->
    <style name="Theme.HanziDictionary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
