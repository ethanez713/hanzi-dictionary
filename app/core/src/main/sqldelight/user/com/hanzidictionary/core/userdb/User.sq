-- On-device user state (spec §7 "On-device user DB (separate)"). App-owned and
-- writable, kept in its own file so it's never entangled with the read-only content
-- pack.
--
-- Item ids are glyph ids ("U+597D") or pack word ids ("w000123") — distinguishable on
-- sight, so no namespacing is needed; `kind` says which.

-- The archive. Deliberately GLOBAL rather than per-list: knowing 好 is a fact about you,
-- not about a list, so archiving it in one list archives it everywhere (spec §17).
CREATE TABLE known_item (
    item_id  TEXT NOT NULL PRIMARY KEY,
    kind     TEXT NOT NULL,               -- character | word
    status   TEXT NOT NULL,               -- known
    added_at INTEGER NOT NULL
);

CREATE TABLE study_list (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    name       TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE list_item (
    list_id  INTEGER NOT NULL,
    item_id  TEXT NOT NULL,
    kind     TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (list_id, item_id)
);

-- FSRS-6 memory state (spec §17). One row per item no matter how many lists hold it:
-- your memory of a character doesn't fork per deck.
CREATE TABLE card_state (
    item_id     TEXT NOT NULL PRIMARY KEY,
    kind        TEXT NOT NULL,
    state       TEXT NOT NULL,            -- learning | review | relearning
    step        INTEGER,                  -- index into the short-term steps; null in review
    stability   REAL,                     -- null until the first grading
    difficulty  REAL,
    due         INTEGER NOT NULL,
    last_review INTEGER,
    reviews     INTEGER NOT NULL DEFAULT 0,
    lapses      INTEGER NOT NULL DEFAULT 0
);

-- Append-only grading history. Not needed to schedule (card_state carries that), but it
-- is exactly the input the FSRS optimiser wants, so keeping it makes personalised
-- parameters possible later without having thrown the evidence away.
CREATE TABLE review_log (
    item_id      TEXT NOT NULL,
    rating       INTEGER NOT NULL,        -- 1 again | 2 hard | 3 good | 4 easy
    ts           INTEGER NOT NULL,
    elapsed_days REAL,
    stability    REAL,                     -- post-review: memory as of this row, not the memory it was graded from
    difficulty   REAL,
    origin       TEXT NOT NULL,           -- app | widget | notification | triage | final | audit
    reveal_ms    INTEGER                  -- face-down time before reveal; app only, else NULL
);

CREATE INDEX review_log_item_ts ON review_log(item_id, ts);

CREATE TABLE app_pref (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE lookup_event (
    item_id TEXT NOT NULL,
    ts      INTEGER NOT NULL
);

CREATE TABLE confusion_event (
    glyph_a TEXT NOT NULL,
    glyph_b TEXT NOT NULL,
    ts      INTEGER NOT NULL
);

-- Watermark for the photo-library scan: the newest photo timestamp already scanned,
-- so we never re-OCR photos taken before the last scan (single row, id = 0).
CREATE TABLE scan_state (
    id                   INTEGER NOT NULL PRIMARY KEY,
    last_photo_timestamp INTEGER NOT NULL
);

-- Chinese characters recognized in the user's photos, powering the "From your photos"
-- feed. A char can be found in several photos; this is an append log, deduped at read.
-- dismissed_at (NULL = live) triages a char out of the feed once the user has dealt with
-- it; keyed per photo, so re-photographing the char adds a fresh, live find that returns.
CREATE TABLE photo_find (
    glyph_id     TEXT NOT NULL,
    photo_id     TEXT NOT NULL,
    found_at     INTEGER NOT NULL,
    dismissed_at INTEGER
);

-- ---- queries ----

upsertKnown:
INSERT OR REPLACE INTO known_item(item_id, kind, status, added_at) VALUES (?, ?, ?, ?);

deleteKnown:
DELETE FROM known_item WHERE item_id = :itemId;

isKnown:
SELECT COUNT(*) > 0 FROM known_item WHERE item_id = :itemId AND status = 'known';

allKnownIds:
SELECT item_id FROM known_item WHERE status = 'known';

allKnown:
SELECT item_id, kind, added_at FROM known_item WHERE status = 'known';

knownAddedAt:
SELECT added_at FROM known_item WHERE item_id = :itemId;

knownCount:
SELECT COUNT(*) FROM known_item WHERE status = 'known';

logLookup:
INSERT INTO lookup_event(item_id, ts) VALUES (?, ?);

getLastScanTimestamp:
SELECT last_photo_timestamp FROM scan_state WHERE id = 0;

setLastScanTimestamp:
INSERT OR REPLACE INTO scan_state(id, last_photo_timestamp) VALUES (0, ?);

insertPhotoFind:
INSERT INTO photo_find(glyph_id, photo_id, found_at) VALUES (?, ?, ?);

-- The feed is a TRIAGE queue, so anything already dealt with leaves it: an explicit
-- dismissal, filing the character into any study list, or archiving it as known. Doing
-- this here rather than at each mutation site means every route out — the feed's own
-- swipe, the character page's list sheet, the widget — clears the character, and taking
-- it back out of your lists puts it back in the queue where it belongs.
recentPhotoFinds:
SELECT glyph_id, MAX(found_at) AS found_at FROM photo_find
WHERE dismissed_at IS NULL
  AND glyph_id NOT IN (SELECT item_id FROM list_item)
  AND glyph_id NOT IN (SELECT item_id FROM known_item WHERE status = 'known')
GROUP BY glyph_id ORDER BY found_at DESC LIMIT :limit;

-- Triage a character out of the feed: mark all its live finds dismissed at :ts.
dismissPhotoFinds:
UPDATE photo_find SET dismissed_at = :ts WHERE glyph_id = :glyphId AND dismissed_at IS NULL;

-- Undo a dismissal (snackbar): restore exactly the finds dismissed in that action.
undismissPhotoFinds:
UPDATE photo_find SET dismissed_at = NULL WHERE glyph_id = :glyphId AND dismissed_at = :ts;

-- Forget dismissals once they age out of the "recently evicted" window.
gcDismissedPhotoFinds:
DELETE FROM photo_find WHERE dismissed_at IS NOT NULL AND dismissed_at < :cutoff;

-- Items the user recently opened (distinct, most-recent first) — the "Recently viewed" feed.
recentLookups:
SELECT item_id, MAX(ts) AS ts FROM lookup_event
GROUP BY item_id ORDER BY ts DESC LIMIT :limit;

-- The practice deck: characters the user has ENCOUNTERED (looked up, or found in a
-- photo) but not archived as known — most recently seen first.
practiceQueue:
SELECT gid, MAX(ts) AS last_seen FROM (
    SELECT item_id AS gid, ts FROM lookup_event
    UNION ALL
    SELECT glyph_id AS gid, found_at AS ts FROM photo_find
)
WHERE gid NOT IN (SELECT item_id FROM known_item WHERE status = 'known')
GROUP BY gid ORDER BY last_seen DESC LIMIT :limit;

-- ---- study lists ----

insertList:
INSERT INTO study_list(name, created_at) VALUES (?, ?);

lastListId:
SELECT last_insert_rowid();

allLists:
SELECT id, name, created_at FROM study_list ORDER BY created_at;

listById:
SELECT id, name, created_at FROM study_list WHERE id = :listId;

renameList:
UPDATE study_list SET name = :name WHERE id = :listId;

deleteList:
DELETE FROM study_list WHERE id = :listId;

deleteAllItemsInList:
DELETE FROM list_item WHERE list_id = :listId;

addListItem:
INSERT OR IGNORE INTO list_item(list_id, item_id, kind, added_at) VALUES (?, ?, ?, ?);

removeListItem:
DELETE FROM list_item WHERE list_id = :listId AND item_id = :itemId;

listIdsContaining:
SELECT list_id FROM list_item WHERE item_id = :itemId;

-- Members of a list, oldest first. Archived (known) items stay in the list — the list is
-- a record of what you studied — so callers filter by known_item when building a deck.
itemsInList:
SELECT item_id, kind, added_at FROM list_item WHERE list_id = :listId ORDER BY added_at;

-- Every studied item across all lists, deduped (an item can sit in several lists).
itemsInAllLists:
SELECT item_id, kind, MIN(added_at) AS added_at FROM list_item
GROUP BY item_id ORDER BY added_at;

-- Every membership row at once: the lists screen needs per-list counts for all lists, and
-- one pass beaten into shape in Kotlin is cheaper than a query per list.
allListItems:
SELECT list_id, item_id, kind, added_at FROM list_item;

countInList:
SELECT COUNT(*) FROM list_item WHERE list_id = :listId;

countArchivedInList:
SELECT COUNT(*) FROM list_item
WHERE list_id = :listId
  AND item_id IN (SELECT item_id FROM known_item WHERE status = 'known');

-- ---- FSRS card state ----

cardState:
SELECT * FROM card_state WHERE item_id = :itemId;

cardStatesFor:
SELECT * FROM card_state WHERE item_id IN :itemIds;

allCardStates:
SELECT * FROM card_state;

upsertCardState:
INSERT OR REPLACE INTO card_state(
    item_id, kind, state, step, stability, difficulty, due, last_review, reviews, lapses
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteCardState:
DELETE FROM card_state WHERE item_id = :itemId;

logReview:
INSERT INTO review_log(item_id, rating, ts, elapsed_days, stability, difficulty, origin, reveal_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- The full grading history of the given items, in time order — what mastery is derived from.
reviewHistory:
SELECT item_id, rating, ts, elapsed_days, origin
FROM review_log
WHERE item_id IN :itemIds
ORDER BY item_id, ts;

-- How many items were introduced (first ever graded) since :since — the new-cards-per-day
-- budget, so adding a 600-character HSK list doesn't dump 600 new cards in one session.
newIntroducedSince:
SELECT COUNT(DISTINCT item_id) FROM review_log
WHERE ts >= :since
  AND item_id NOT IN (SELECT item_id FROM review_log WHERE ts < :since);

reviewCountSince:
SELECT COUNT(*) FROM review_log WHERE ts >= :since;

-- One row per grading since :since, for the activity streak. Triage is a claim, not a
-- review, so it must not paint a day as studied.
reviewItemsSince:
SELECT ts, item_id
FROM review_log
WHERE ts >= :since AND origin <> 'triage';

-- The latest real reviews' ratings, newest first — the "is the current deck manageable?" gate
-- on suggesting new words. Triage self-reports are claims, not reviews, so they don't count.
-- Final-check and archive spot-check grades are retrievals, so this filter leaves them in.
recentRatings:
SELECT rating FROM review_log WHERE origin <> 'triage' ORDER BY ts DESC LIMIT :limit;

-- Newest grading of one item. rowid breaks a shared timestamp toward the later insert.
newestReviewFor:
SELECT ts, stability, difficulty
FROM review_log
WHERE item_id = :itemId
ORDER BY ts DESC, rowid DESC
LIMIT 1;

-- Newest grading of every item. A shared timestamp can match twice; the caller keeps
-- the greater rowid. Archiving deletes card_state, so this row is the only memory left.
newestReviews:
SELECT r.item_id AS item_id, r.ts AS ts, r.stability AS stability, r.difficulty AS difficulty, r.rowid AS review_rowid
FROM review_log r
INNER JOIN (
    SELECT item_id AS latest_item, MAX(ts) AS latest_ts
    FROM review_log
    GROUP BY item_id
) AS latest ON r.item_id = latest.latest_item AND r.ts = latest.latest_ts;

lastInsertedRowId:
SELECT last_insert_rowid();

deleteReviewRow:
DELETE FROM review_log WHERE rowid = :rowId;

allCardItemIds:
SELECT item_id FROM card_state;

-- Words the user swiped past during new-word triage ("not now"), kept in app_pref so no new
-- table is needed; the key carries the item id and the value the time it was skipped.
triageSkips:
SELECT key, value FROM app_pref WHERE key LIKE 'triage_skip:%';

-- Newest grading from any origin (null before the first), for the reminder's "have they
-- already studied today / how long since" rules.
lastReviewTs:
SELECT MAX(ts) FROM review_log;

-- ---- preferences ----

getPref:
SELECT value FROM app_pref WHERE key = :key;

setPref:
INSERT OR REPLACE INTO app_pref(key, value) VALUES (?, ?);
