-- v1 -> v2: study lists + FSRS scheduling (spec §17, milestone M3.56).
--
-- Additive only. An installed app already holds the user's archive, lookup history and
-- photo finds in v1 tables, and none of them change — losing an archive built by hand
-- (or by HSK import) would be the worst possible outcome of this feature.

CREATE TABLE study_list (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    name       TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

CREATE TABLE list_item (
    list_id  INTEGER NOT NULL,
    item_id  TEXT NOT NULL,
    kind     TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (list_id, item_id)
);

CREATE TABLE card_state (
    item_id     TEXT NOT NULL PRIMARY KEY,
    kind        TEXT NOT NULL,
    state       TEXT NOT NULL,
    step        INTEGER,
    stability   REAL,
    difficulty  REAL,
    due         INTEGER NOT NULL,
    last_review INTEGER,
    reviews     INTEGER NOT NULL DEFAULT 0,
    lapses      INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE review_log (
    item_id      TEXT NOT NULL,
    rating       INTEGER NOT NULL,
    ts           INTEGER NOT NULL,
    elapsed_days REAL,
    stability    REAL,
    difficulty   REAL,
    origin       TEXT NOT NULL
);

CREATE TABLE app_pref (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);
