-- Schema mirrors the pipeline's schema.sql (spec §7). The app ships a prebuilt pack,
-- so SQLDelight never runs these CREATE statements at runtime — they exist only so it
-- can type the queries below. The FTS5 table (glyph_fts) is intentionally NOT declared
-- here; it's queried via a raw driver call in the repository so SQLDelight's schema
-- parser never has to deal with the virtual-table syntax.

CREATE TABLE source (
    id          TEXT PRIMARY KEY,
    name        TEXT NOT NULL,
    license     TEXT NOT NULL,
    url         TEXT NOT NULL,
    version     TEXT NOT NULL,
    ingest_date TEXT NOT NULL
);

CREATE TABLE glyph (
    id           TEXT PRIMARY KEY,
    char         TEXT NOT NULL,
    scripts      TEXT NOT NULL,
    stroke_count INTEGER,
    freq_rank    INTEGER,
    hsk          INTEGER,
    definition   TEXT,
    cedict_defs  TEXT
);

CREATE TABLE reading (
    glyph_id   TEXT NOT NULL,
    system     TEXT NOT NULL,
    value      TEXT NOT NULL,
    sense_hint TEXT,
    freq       INTEGER,
    source_id  TEXT NOT NULL
);

CREATE TABLE decomposition (
    glyph_id  TEXT NOT NULL,
    ids       TEXT NOT NULL,
    region    TEXT,
    source_id TEXT NOT NULL
);

CREATE TABLE component_use (
    glyph_id     TEXT NOT NULL,
    component_id TEXT NOT NULL,
    position     INTEGER NOT NULL,
    function     TEXT NOT NULL,
    match_class  TEXT,
    confidence   REAL,
    resolution   TEXT NOT NULL
);

CREATE TABLE claim (
    subject_id   TEXT NOT NULL,
    predicate    TEXT NOT NULL,
    value        TEXT NOT NULL,
    source_id    TEXT NOT NULL,
    source_ref   TEXT,
    confidence   REAL,
    retrieved_at TEXT NOT NULL
);

CREATE TABLE variant_edge (
    from_glyph      TEXT NOT NULL,
    to_glyph        TEXT NOT NULL,
    relation        TEXT NOT NULL,
    mapping_type    TEXT,
    sense_condition TEXT,
    source_id       TEXT NOT NULL
);

CREATE TABLE phonetic_series (
    component_id TEXT PRIMARY KEY,
    member_count INTEGER NOT NULL,
    reliability  REAL NOT NULL,
    best_stratum TEXT NOT NULL
);

CREATE TABLE confusable (
    glyph_a TEXT NOT NULL,
    glyph_b TEXT NOT NULL,
    kind    TEXT NOT NULL,
    diff    TEXT
);

CREATE TABLE word (
    id        TEXT PRIMARY KEY,
    simp      TEXT NOT NULL,
    trad      TEXT NOT NULL,
    pinyin    TEXT,
    defs      TEXT,
    freq_rank INTEGER,
    hsk       INTEGER
);

CREATE TABLE word_char (
    word_id  TEXT NOT NULL,
    glyph_id TEXT NOT NULL,
    position INTEGER NOT NULL
);

-- Example sentences (Tatoeba, CC BY 2.0 FR), keyed by the word's simplified form.
-- Sentences judged unidiomatic are marked shown=0, never deleted, so the ranking stays
-- auditable and undoing it is a change to sentencesForWord rather than a rebuild.
CREATE TABLE sentence (
    simp       TEXT NOT NULL,
    zh         TEXT NOT NULL,
    en         TEXT,
    tatoeba_id INTEGER,
    quality    INTEGER,
    shown      INTEGER NOT NULL DEFAULT 1
);
CREATE INDEX idx_sentence_simp ON sentence(simp);

-- What a component contributes to a character, which is not its standalone meaning:
-- 页 alone is "page" but lends 项 its "head". Voted from makemeahanzi role hints.
CREATE TABLE component_gloss (
    component_id TEXT PRIMARY KEY,
    gloss        TEXT NOT NULL,
    source_id    TEXT NOT NULL,
    support      INTEGER NOT NULL,
    agreement    REAL NOT NULL
);

-- ---- queries ----

glyphByChar:
SELECT * FROM glyph WHERE char = :char;

glyphById:
SELECT * FROM glyph WHERE id = :id;

glyphsByIds:
SELECT * FROM glyph WHERE id IN :ids;

readingsForGlyph:
SELECT * FROM reading WHERE glyph_id = :glyphId;

decompositionsForGlyph:
SELECT * FROM decomposition WHERE glyph_id = :glyphId;

componentUseForGlyph:
SELECT * FROM component_use WHERE glyph_id = :glyphId ORDER BY position;

componentGlossFor:
SELECT gloss FROM component_gloss WHERE component_id = :componentId;

claimsForSubject:
SELECT * FROM claim WHERE subject_id = :subjectId;

variantsFrom:
SELECT * FROM variant_edge WHERE from_glyph = :glyphId;

variantsTo:
SELECT * FROM variant_edge WHERE to_glyph = :glyphId;

phoneticSeriesFor:
SELECT * FROM phonetic_series WHERE component_id = :componentId;

-- Characters that use :componentId, with the glyph's char + frequency for
-- known-first / frequency ordering on the component page (spec §9).
charactersUsingComponent:
SELECT cu.glyph_id AS glyphId,
       cu.function AS function,
       cu.match_class AS matchClass,
       cu.confidence AS confidence,
       g.char AS char,
       g.freq_rank AS freqRank
FROM component_use cu
JOIN glyph g ON g.id = cu.glyph_id
WHERE cu.component_id = :componentId
ORDER BY (g.freq_rank IS NULL), g.freq_rank;

-- diff carries the shared component for kind='component' rows, and the shape encoding that
-- vouched for a kind='shape' pair; NULL for kSpoofingVariant.
confusablesFor:
SELECT glyph_a, glyph_b, kind, diff FROM confusable WHERE glyph_a = :glyphId OR glyph_b = :glyphId;

-- Trad→simp edges where BOTH endpoints are in :ids — used to fold a traditional
-- character's search row into its simplified counterpart's.
simplificationEdgesAmong:
SELECT from_glyph, to_glyph FROM variant_edge
WHERE relation = 'simplification' AND from_glyph IN :ids AND to_glyph IN :ids;

-- Words containing :glyphId, most-common first: corpus frequency (OpenSubtitles),
-- HSK level as tiebreak/fallback, then shorter words.
wordsForGlyph:
SELECT w.id, w.simp, w.trad, w.pinyin, w.defs, w.hsk
FROM word_char wc JOIN word w ON w.id = wc.word_id
WHERE wc.glyph_id = :glyphId
ORDER BY (w.freq_rank IS NULL), w.freq_rank, (w.hsk IS NULL), w.hsk,
         LENGTH(w.simp), w.pinyin
LIMIT :limit;

wordsByIds:
SELECT * FROM word WHERE id IN :ids;

sentencesForWord:
SELECT zh, en FROM sentence WHERE simp = :simp AND shown = 1 LIMIT :limit;

-- Phonetic-series look-alikes: characters that share the phonetic component of any of :ids
-- (请/清/晴/情 all carry 青), common ones first. Self-exclusion is done by the caller.
seriesSiblings:
SELECT DISTINCT g.id, g.char, g.definition, g.freq_rank,
    (SELECT r.value FROM reading r WHERE r.glyph_id = g.id AND r.system = 'pinyin'
     ORDER BY (r.freq IS NULL), r.freq DESC LIMIT 1) AS pinyin
FROM component_use cu_self
JOIN component_use cu_other ON cu_other.component_id = cu_self.component_id
JOIN glyph g ON g.id = cu_other.glyph_id
WHERE cu_self.glyph_id IN :ids
  AND cu_self.function = 'phonetic'
  AND cu_self.component_id NOT LIKE 'ids:%'
  AND g.freq_rank IS NOT NULL AND g.freq_rank <= :maxRank
ORDER BY g.freq_rank
LIMIT :limit;

glyphWithPinyin:
SELECT g.id, g.char, g.definition,
    (SELECT r.value FROM reading r WHERE r.glyph_id = g.id AND r.system = 'pinyin'
     ORDER BY (r.freq IS NULL), r.freq DESC LIMIT 1) AS pinyin
FROM glyph g WHERE g.id = :glyphId;

wordById:
SELECT * FROM word WHERE id = :id;

allSources:
SELECT * FROM source;
